# ─────────────────────────────────────────────────────────────
# Portal EVP — variáveis de ambiente
# Copie para .env.local e preencha quando o projeto Supabase existir.
# ─────────────────────────────────────────────────────────────

# Supabase (projeto ainda não criado — preencher depois)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Login com Google (Supabase Auth).
# Local: o supabase CLI lê estas variáveis via config.toml ([auth.external.google]).
# Produção: configurar no dashboard do Supabase (Authentication > Providers > Google).
# As credenciais saem do Google Cloud Console (OAuth client "Web application"),
# com redirect URI https://<project-ref>.supabase.co/auth/v1/callback.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# URL pública do app (usada nos links dos e-mails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend (envio do código de login)
RESEND_API_KEY=
RESEND_FROM=Portal EVP <contato@atualizacoes.crmmultimeta.com.br>

# Hotmart — token do webhook (Configurações do produto > Webhook/Postback)
# Token do postback da Hotmart (mesmo da conta, o que o CRM já usa). Sem ele o
# webhook rejeita tudo com 401. O postback da Comunidade VIP aponta para cá E
# para o CRM: os dois caminhos levam ao mesmo veredito, e nenhum depende do outro.
HOTMART_HOTTOK=

# Janela de liberação após a compra (dias). Padrão: 7 (janela de reembolso).
ACCESS_WAITING_PERIOD_DAYS=7
